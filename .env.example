# ── Base de données (Supabase) ──
NUXT_DATABASE_URL=postgres://postgres:[MOT DE PASSE]@[PROJET].supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgres://postgres:[MOT DE PASSE]@[PROJET].supabase.co:5432/postgres?sslmode=require

# ── Dossier dev scanné par le Companion (brain:scan) ──
NUXT_DEV_ROOT_PATH=C:/Users/Sofiane/Desktop/dev

# ── URL du serveur OSSO ciblé par le Companion ──
# Production Vercel par défaut. Passer http://localhost:3000 pour un retour en local.
NUXT_OSS_URL=https://ossodev.vercel.app

# ── Secret partagé Companion (OBLIGATOIRE) ──
# Généré par `node scripts/companion-init.mjs` : il est écrit ici ET dans
# %APPDATA%\osso-companion\config.json. Sans lui, /api/companion/* répond 500
# et le tray ne peut vérifier la signature des commandes.
COMPANION_SECRET=

# ── Commandes exécutées localement par le Companion (optionnel) ──
# Laisser vide : le dashboard affichera la commande à copier au lieu de l'exécuter.
NUXT_BRAIN_COMMAND=
NUXT_TERMINAL_COMMAND=
