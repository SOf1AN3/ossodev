    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.15.30",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "nuxt": "^4.1.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
